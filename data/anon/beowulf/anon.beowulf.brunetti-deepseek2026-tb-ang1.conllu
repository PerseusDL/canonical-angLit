# sent_id = beowulf.00061
# text = þū wāst, gif hit is swā wē sōþlīce secgan hȳrdon, þæt mid Scyldingum sceaðona ic nāt hwylc, dēogol dǣdhata deorcum nihtum ēaweð þurh egsan uncūðne nīð, hȳnðu ond hrāfyl.
# ref = 272-277
# source_version = perseus-ang1
# base_analysis = Giuseppe Brunetti
# dependency_model = deepseek-chat
# reading_translation = You know, if it is as we have truly heard tell, that among the Scyldings some enemy — I know not which, a mysterious persecutor — in the dark nights manifests through terror an unheard-of hostility, humiliation and slaughter.
