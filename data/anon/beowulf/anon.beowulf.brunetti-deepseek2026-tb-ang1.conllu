# text = Wealhðēo maþelode, hēo fore þǣm werede spræc: ' Brūc ðisses bēages, Bēowulf lēofa, hyse, mid hǣle, ond þisses hrægles nēot, þēo[d]gestrēona, ond geþēoh tela, cen þec mid cræfte, ond þyssum cnyhtum wes lāra līðe!
# ref = 1215-1220
# source_version = perseus-ang1
# base_analysis = Giuseppe Brunetti
