# sent_id = beowulf.00434
# text = Hit on endestæf eft gelimpeð, þæt se līchoma lǣne gedrēoseð, fǣge gefealleð; fēhð ōþer tō, sē þe unmurnlīce mādmas dǣleþ, eorles ǣrgestrēon, egesan ne gȳmeð.
# ref = 1753-1757
