# sent_id = beowulf.00497
# text = Mæg þæs þonne ofþyncan ðēodne Heaðo-Beardna ond þegna gehwām þāra leoda, þonne hē mid fǣmnan on flett geað, -- dryhtbearn Dena duguða biwenede; on him gladiað gomelra lāfe, heard ond hringmǣl Heaða-Bear[d]na gestrēon, þenden hīe ðām wǣpnum wealdan mōston, -- oð ðæt hīe forlǣddan tō ðām lindplegan swǣse gesīðas ond hyra sylfra feorh.
# ref = 2032-2040
# source_version = perseus-ang1
# base_analysis = Giuseppe Brunetti
# dependency_model = deepseek-chat
# reading_translation = That may then displease the lord of the Heatho-Beards and each retainer of those peoples, when he goes with the maiden onto the hall floor, -- the noble-born son of the Danes entertained them lavishly; on him gleam the heirlooms of ancestors, hard and ring-marked, the treasure of the Heatho-Beards, while they might wield those weapons, -- until they led to destruction, to that shield-play, dear companions and their own lives.
# literal_translation = May that then displease the lord of the Heatho-Beards and each retainer of those peoples, when he with the maiden on the hall floor goes, -- noble-born son of Danes with excellence entertained; on him gleam of ancestors heirlooms, hard and ring-marked Heatho-Beards' treasure, while they those weapons wield might, -- until they led to destruction to that shield-play dear companions and their own lives.
