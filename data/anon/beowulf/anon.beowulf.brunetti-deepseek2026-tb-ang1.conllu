# sent_id = beowulf.00338
# text = Ic þæt londbūend, lēode mæine, selerǣdende secgan hȳrde, þæt hīe gesāwon swylce twēgen micle mearcstapan mōras healdan, ellorgǣstas.
# ref = 1345-1349
