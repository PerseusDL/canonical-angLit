# sent_id = beowulf.00632
# text = Dē hē ūsic on herge gecēas tō ðyssum sīðfate sylfes willum, onmunde ūsic mǣrða, ond mē þās māðmas geaf, þē hē ūsic gārwīgend gōde tealde, hwate helmberend,-- þēah ðe hlāford ūs þis ellenweorc āna āðōhte tō gefremmanne, folces hyrde, forðām hē manna mǣst mǣrða gefremede, dǣda dollīcra.
# ref = 2638-2646
# source_version = perseus-ang1
# base_analysis = Giuseppe Brunetti
# dependency_model = deepseek-chat
# reading_translation = He chose us in the army for this expedition by his own will, counted us worthy of glory, and gave me these treasures, because he reckoned us good spear-fighters, bold helmet-bearers -- although the lord intended alone to perform this deed of courage for us, the guardian of the people, because he performed the most glorious deeds of men, of audacious deeds.
# literal_translation = He us in army chose for this expedition of (his) own will, accounted us worthy of glories, and to me these treasures gave, because he us spear-fighters good reckoned, bold helmet-bearers -- though the lord for us this courage-work alone intended to perform, people's guardian, because he of men most of glories performed, of deeds audacious.
