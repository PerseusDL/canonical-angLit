# sent_id = beowulf.00432
# text = Wunað hē on wiste; nō hine wiht dweleð ādl nē yldo, nē him inwitsorh on sefa(n) sweorceð, nē gesacu ōhwǣr ecghete ēoweð, ac him eal worold wendeð on willan; hē þæt wyrse ne con --, oð þæt him on innan oferhygda dǣl weaxeð ond wrīdað; þonne se weard swefeð, sāwele hyrde; bið se slǣp tō fæst, bisgum gebunden, bona swīðe nēah, sē þe of flānbogan fyrenum scēoteð.
# ref = 1735-1744
# source_version = perseus-ang1
# base_analysis = Giuseppe Brunetti
# dependency_model = deepseek-chat
# reading_translation = He dwells in abundance; nothing at all hinders him, neither sickness nor old age, nor does dire sorrow darken his heart, nor does strife anywhere manifest sword-hate, but all the world turns for him at his will; he does not know the worse fate -- until within him a portion of arrogance grows and flourishes; then the guardian sleeps, the soul's keeper; that sleep is too deep, bound by cares, the slayer very near, he who wickedly shoots from the bow.
# literal_translation = Dwells he in abundance; not at all him aught hinders, sickness nor old age, nor to him dire-sorrow in heart darkens, nor strifes anywhere sword-hate manifests, but to him all world turns at will; he that worse not knows --, until to him in within of arrogances a deal grows and flourishes; then the guardian sleeps, soul's keeper; is the sleep too fast, by cares bound, slayer very near, he who from bow with crimes shoots.
