# sent_id = beowulf.00707
# text = Hē ð(ām) frætwum fēng ond him fægre gehēt lēana (mid) lēodum, ond gelǣste swā; geald þone gūðrǣs Gēata dryhten, Hrēðles eafora, þā hē tō hām becōm, Iofore ond Wulfe mid ofermāðmum, sealde hiora gehwæðrum hund þūsenda landes ond locenra bēaga,-- ne ðorfte him ðā lēan oðwītan mon on middangearde, syðða[n] hīe ðā mǣrða geslōgon; ond ðā Iofore forgeaf āngan dohtor, hāmweorðunge, hyldo tō wedde.
# ref = 2989-2998
