# sent_id = beowulf.00003
# text = Ðǣm eafera wæs æfter cenned geong in geardum, þone God sende folce tō frōfre; fyrenðearfe ongeat, þē hīe ǣr drugon aldor(lē)ase lange hwīle; him þæs Liffrea, wuldres Wealdend woroldāre forgeaf; Bēowulf wæs brēme -- blǣd wīde sprang -- Scyldes eafera Scedelandum in.
# ref = 12-19
# source_version = perseus-ang1
# model = deepseek-chat
# reading_translation = To him a son was afterwards born, young in the courts, whom God sent to the people as a comfort; He perceived their dire need, which they had endured before, lordless, for a long while; for them the Lord of Life, the Ruler of glory, granted worldly honor; Beowulf was renowned -- his fame sprang widely -- the son of Scyld, in the Scylding lands.
# literal_translation = To-him a-son was afterwards born, young in courts, whom God sent to-the-people as comfort; dire-need he-perceived, which they before endured lordless for-a-long while; to-them for-that the-Life-Lord, of-glory the-Ruler, world-honor granted; Beowulf was famous -- fame widely sprang -- Scyld's son in-Scylding-lands.
