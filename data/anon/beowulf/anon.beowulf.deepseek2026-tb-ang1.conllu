# sent_id = beowulf.00098
# text = Ic þē nū ðā, brego Beorht-Dena, biddan wille, eodor Scyldinga, ānre bēne, þæt ðū mē ne forwyrne, wīgendra hlēo, frēowine folca, nū ic þus feorran cōm, þæt ic mōte āna [ond] mīnra eorla gedryht, þes hearda hēap, Heorot fǣlsian.
# ref = 426-432
# source_version = perseus-ang1
# model = deepseek-chat
# reading_translation = I now wish to ask you, prince of the Bright-Danes, protector of the Scyldings, for one favor: that you not refuse me, protector of warriors, lord and friend of peoples, now that I have come thus from afar, that I alone, along with the band of my earls, this hard troop, may cleanse Heorot.
# literal_translation = I you now then, prince of-Bright-Danes, to-bid will, protector of-Scyldings, one favor, that you me not refuse, of-warriors protection, free-lord of-peoples, now I thus from-far came, that I may alone [and] of-my earls troop, this hard heap, Heorot cleanse.
